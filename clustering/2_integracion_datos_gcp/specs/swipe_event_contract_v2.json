    },
    "dwell_ms": {
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "event_id": {
      "type": "string"
    },
    "event_snapshot": {
      "properties": {
        "banda_precio": {
          "type": [
            "string",
            "null"
          ]
        },
        "ciudad": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_id": {
          "type": "string"
        },
        "fecha_evento": {
          "format": "date",
          "type": [
            "string",
            "null"
          ]
        },
        "genero": {
          "type": [
            "string",
            "null"
          ]
        },
        "precio_max": {
          "type": [
            "number",
            "null"
          ]
        },
        "precio_min": {
          "type": [
            "number",
            "null"
          ]
        },
        "recinto_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "segmento": {
          "type": [
            "string",
            "null"
          ]
        },
        "subgenero": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "event_id"
      ],
      "type": "object"
    },
    "producer": {
      "properties": {
        "client_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "surface": {
          "enum": [
            "swipe",
            "chat"
          ],
          "type": "string"
        }
      },
      "required": [
        "surface"
      ],
      "type": "object"
    },
    "rank_position": {
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "recommendation_context": {
      "enum": [
